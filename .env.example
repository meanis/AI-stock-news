OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
FINNHUB_API_KEY=...
# ALPHAVANTAGE_API_KEY=...        # optional; uncomment to enable the fallback provider
NEWS_LOOKBACK_DAYS=7
